{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "uvicorn floodmap.api.server:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/analyses/trishuli-demo",
    "restartPolicyType": "ON_FAILURE"
  }
}
